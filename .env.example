# PostgreSQL connection string.
# Default port 5433 matches `compose.yml` (5432 inside the network, 5433 on the host)
# to avoid colliding with a local/system postgres on 5432.
# Override `POSTGRES_PORT` in your shell + change the port below if you want 5432.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/app

# better-auth
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
